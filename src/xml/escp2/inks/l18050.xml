  xsi:schemaLocation="http://gimp-print.sourceforge.net/xsd/gp.xsd-1.0 gutenprint.xsd">
  <copyright>
    * EPSON L18050 physical six-channel raw ink layout.
  </copyright>
  <escp2InkGroup name="l18050">
    <InkList translate="text" name="Physical" text="L18050 Physical Raw Inks">
      <Shades>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
      </Shades>
      <InkName translate="text" name="Physical6" text="Physical Six Channel Raw" InkID="Extended">
        <Channels>
          <channel name="l18050_physical_k" index="0">
            <subchannel color="0" subchannel="0" headOffset="1" name="Black" text="Black" translate="text">
              <ChannelDensityParam name="RawChannelDensity0" />
            </subchannel>
          </channel>
          <channel name="l18050_physical_lc" index="1">
            <subchannel color="2" subchannel="1" headOffset="0" name="LightCyan" text="Light Cyan" translate="text">
