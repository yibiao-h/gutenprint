          </channel>
          <channel name="l18050_physical_lm" index="5">
            <subchannel color="1" subchannel="1" headOffset="0" name="LightMagenta" text="Light Magenta" translate="text">
              <ChannelDensityParam name="RawChannelDensity5" />
            </subchannel>
          </channel>
        </Channels>
      </InkName>
    </InkList>
  </escp2InkGroup>
</gutenprint>
