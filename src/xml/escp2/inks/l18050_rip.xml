<?xml version="1.0"?>

<gutenprint xmlns="http://gimp-print.sourceforge.net/xsd/gp.xsd-1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://gimp-print.sourceforge.net/xsd/gp.xsd-1.0 gutenprint.xsd">
  <copyright>
    * EPSON L18050 white/color RIP PoC inks.
    * The worker renders 90-nozzle intermediate data. The proprietary main app
    * parses and pads those intermediate PRNs into the final 180-nozzle stream.
</copyright>
  <escp2InkGroup name="l18050_rip">
    <InkList translate="text" name="None" text="L18050 RIP PoC Inks">
      <Shades>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade>
      </Shades>

      <InkName translate="text" name="ColorBase0" text="Color 90 Nozzles Base" InkID="CMYK">
        <Channels>
          <channel name="l18050_black_base" index="0">
            <subchannel color="0" subchannel="0" name="Black" text="Black" translate="text">
              <ChannelDensityParam name="BlackDensity" />
            </subchannel>
          </channel>
          <channel name="l18050_cyan_base" index="1">
            <HueCurveParam name="CyanHueCurve" />
            <subchannel color="2" subchannel="0" name="Cyan" text="Cyan" translate="text">
              <ChannelDensityParam name="CyanDensity" />
            </subchannel>
          </channel>
          <channel name="l18050_magenta_base" index="2">
            <HueCurveParam name="MagentaHueCurve" />
            <subchannel color="1" subchannel="0" name="Magenta" text="Magenta" translate="text">
              <ChannelDensityParam name="MagentaDensity" />
            </subchannel>
          </channel>
          <channel name="l18050_yellow_base" index="3">
            <HueCurveParam name="YellowHueCurve" />
            <subchannel color="4" subchannel="0" name="Yellow" text="Yellow" translate="text">
              <ChannelDensityParam name="YellowDensity" />
            </subchannel>
          </channel>
        </Channels>
        <AuxChannels>
          <channel name="l18050_gloss_anchor" index="0">
            <subchannel color="9" name="Gloss" text="Gloss Anchor" translate="text">
              <ChannelDensityParam name="GlossDensity" />
            </subchannel>
          </channel>
        </AuxChannels>
      </InkName>

      <InkName translate="text" name="ColorOffset90" text="Color 90 Nozzles Offset" InkID="CMYK">
        <Channels>
          <channel name="l18050_black_offset" index="0">
            <subchannel color="0" subchannel="0" headOffset="180" name="Black" text="Black"
              translate="text">
              <ChannelDensityParam name="BlackDensity" />
            </subchannel>
          </channel>
          <channel name="l18050_cyan_offset" index="1">
            <HueCurveParam name="CyanHueCurve" />
            <subchannel color="2" subchannel="0" headOffset="180" name="Cyan" text="Cyan"
              translate="text">
              <ChannelDensityParam name="CyanDensity" />
            </subchannel>
          </channel>
          <channel name="l18050_magenta_offset" index="2">
            <HueCurveParam name="MagentaHueCurve" />
            <subchannel color="1" subchannel="0" headOffset="180" name="Magenta" text="Magenta"
              translate="text">
              <ChannelDensityParam name="MagentaDensity" />
            </subchannel>
          </channel>
          <channel name="l18050_yellow_offset" index="3">
            <HueCurveParam name="YellowHueCurve" />
            <subchannel color="4" subchannel="0" headOffset="180" name="Yellow" text="Yellow"
              translate="text">
              <ChannelDensityParam name="YellowDensity" />
            </subchannel>
          </channel>
        </Channels>
        <AuxChannels>
          <channel name="l18050_gloss_anchor" index="0">
            <subchannel color="9" name="Gloss" text="Gloss Anchor" translate="text">
              <ChannelDensityParam name="GlossDensity" />
            </subchannel>
          </channel>
        </AuxChannels>
      </InkName>

      <InkName translate="text" name="WhiteBase0" text="White 90 Nozzles Base" InkID="OTHER">
        <Channels>
          <channel name="l18050_white_lc_base" index="0">
            <subchannel color="2" subchannel="1" name="Black"
              text="Light Cyan White" translate="text">
              <ChannelDensityParam name="BlackDensity" />
              <!-- <SplitChannels count="2">17 18</SplitChannels> -->
            </subchannel>
          </channel>
          <channel name="l18050_white_lm_base" index="1">
            <subchannel color="1" subchannel="1" name="Black"
              text="Light Magenta White" translate="text">
              <ChannelDensityParam name="BlackDensity" />
            </subchannel>
          </channel>
        </Channels>
        <AuxChannels>
          <channel name="l18050_gloss_anchor" index="0">
            <subchannel color="9" name="Gloss" text="Gloss Anchor" translate="text">
              <ChannelDensityParam name="GlossDensity" />
            </subchannel>
          </channel>
        </AuxChannels>
      </InkName>

      <InkName translate="text" name="WhiteOffset90" text="White 90 Nozzles Offset" InkID="OTHER">
        <Channels>
          <channel name="l18050_white_lc_offset" index="0">
            <subchannel color="2" subchannel="1" headOffset="180" name="Black"
              text="Light Cyan White" translate="text">
              <ChannelDensityParam name="BlackDensity" />
              <!-- <SplitChannels count="2">17 18</SplitChannels> -->
            </subchannel>
          </channel>
          <channel name="l18050_white_lm_offset" index="1">
            <subchannel color="1" subchannel="1" headOffset="180" name="Black"
              text="Light Magenta White" translate="text">
              <ChannelDensityParam name="BlackDensity" />
            </subchannel>
          </channel>
        </Channels>
        <AuxChannels>
          <channel name="l18050_gloss_anchor" index="0">
            <subchannel color="9" name="Gloss" text="Gloss Anchor" translate="text">
              <ChannelDensityParam name="GlossDensity" />
            </subchannel>
          </channel>
        </AuxChannels>
      </InkName>
    </InkList>
  </escp2InkGroup>
</gutenprint>