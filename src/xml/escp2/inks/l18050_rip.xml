<?xml version="1.0"?>

<gutenprint xmlns="http://gimp-print.sourceforge.net/xsd/gp.xsd-1.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://gimp-print.sourceforge.net/xsd/gp.xsd-1.0 gutenprint.xsd">
<copyright>
 * EPSON L18050 white/color RIP PoC inks.
 * The worker renders 90-nozzle intermediate data. The proprietary main app
 * parses and pads those intermediate PRNs into the final 180-nozzle stream.
</copyright>
<escp2InkGroup name="l18050_rip">
<InkList translate="text" name="None" text="L18050 RIP PoC Inks">
  <Shades>
   <shade count="3">1.000000 0.350000 0.350000</shade>
   <shade count="2">1.000000 0.350000</shade>
   <shade count="2">1.000000 0.350000</shade>
   <shade count="1">1.000000</shade>
   <shade count="1">1.000000</shade>
  <shade count="1">1.000000</shade>
 </Shades>

 <InkName translate="text" name="ColorBase0" text="Color 90 Nozzles Base" InkID="CMYK">
  <Channels>
   <channel name="l18050_black_base" index="0">
    <subchannel color="0" subchannel="0" name="Black" text="Black" translate="text">
     <ChannelDensityParam name="BlackDensity"/>
    </subchannel>
   </channel>
   <channel name="l18050_cyan_base" index="1">
    <HueCurveParam name="CyanHueCurve"/>
    <subchannel color="2" subchannel="0" name="Cyan" text="Cyan" translate="text">
     <ChannelDensityParam name="CyanDensity"/>
    </subchannel>
   </channel>
   <channel name="l18050_magenta_base" index="2">
    <HueCurveParam name="MagentaHueCurve"/>
    <subchannel color="1" subchannel="0" name="Magenta" text="Magenta" translate="text">
     <ChannelDensityParam name="MagentaDensity"/>
    </subchannel>
   </channel>
   <channel name="l18050_yellow_base" index="3">
    <HueCurveParam name="YellowHueCurve"/>
    <subchannel color="4" subchannel="0" name="Yellow" text="Yellow" translate="text">
     <ChannelDensityParam name="YellowDensity"/>
    </subchannel>
   </channel>
  </Channels>
 </InkName>

 <InkName translate="text" name="ColorOffset90" text="Color 90 Nozzles Offset" InkID="CMYK">
  <Channels>
   <channel name="l18050_black_offset" index="0">
    <subchannel color="1" subchannel="1" name="ColorOffsetAnchor" text="Color Offset Anchor" translate="text">
     <ChannelDensityParam name="BlackDensity"/>
     <SubchannelValueParam name="LightMagentaValue"/>
     <SubchannelScaleParam name="LightMagentaScale"/>
    </subchannel>
    <subchannel color="0" subchannel="0" headOffset="90" name="Black" text="Black" translate="text">
     <ChannelDensityParam name="BlackDensity"/>
    </subchannel>
   </channel>
   <channel name="l18050_cyan_offset" index="1">
    <HueCurveParam name="CyanHueCurve"/>
    <subchannel color="2" subchannel="0" headOffset="90" name="Cyan" text="Cyan" translate="text">
     <ChannelDensityParam name="CyanDensity"/>
    </subchannel>
   </channel>
   <channel name="l18050_magenta_offset" index="2">
    <HueCurveParam name="MagentaHueCurve"/>
    <subchannel color="1" subchannel="0" headOffset="90" name="Magenta" text="Magenta" translate="text">
     <ChannelDensityParam name="MagentaDensity"/>
    </subchannel>
   </channel>
   <channel name="l18050_yellow_offset" index="3">
    <HueCurveParam name="YellowHueCurve"/>
    <subchannel color="4" subchannel="0" headOffset="90" name="Yellow" text="Yellow" translate="text">
     <ChannelDensityParam name="YellowDensity"/>
    </subchannel>
   </channel>
  </Channels>
 </InkName>

  <InkName translate="text" name="WhiteBase0" text="White 90 Nozzles Base" InkID="CcMmYK">
  <Channels>
   <channel name="l18050_white_base" index="0">
    <subchannel color="2" subchannel="1" name="LightCyanWhite" text="Light Cyan White" translate="text">
     <ChannelDensityParam name="CyanDensity"/>
     <SubchannelValueParam name="LightCyanValue"/>
     <SubchannelScaleParam name="LightCyanScale"/>
    </subchannel>
    <subchannel color="1" subchannel="1" name="LightMagentaWhite" text="Light Magenta White" translate="text">
     <ChannelDensityParam name="MagentaDensity"/>
     <SubchannelValueParam name="LightMagentaValue"/>
     <SubchannelScaleParam name="LightMagentaScale"/>
    </subchannel>
   </channel>
  </Channels>
 </InkName>

<InkName translate="text" name="WhiteOffset90" text="White 90 Nozzles Offset" InkID="CcMmYK">
   <Channels>
    <channel name="l18050_white_offset" index="0">
     <subchannel color="1" subchannel="0" name="WhiteOffsetAnchor" text="White Offset Anchor" translate="text">
      <ChannelDensityParam name="CyanDensity"/>
     </subchannel>
     <subchannel color="2" subchannel="1" headOffset="90" name="LightCyanWhite" text="Light Cyan White" translate="text">
      <ChannelDensityParam name="CyanDensity"/>
      <SubchannelValueParam name="LightCyanValue"/>
      <SubchannelScaleParam name="LightCyanScale"/>
     </subchannel>
     <subchannel color="1" subchannel="1" headOffset="90" name="LightMagentaWhite" text="Light Magenta White" translate="text">
      <ChannelDensityParam name="MagentaDensity"/>
      <SubchannelValueParam name="LightMagentaValue"/>
      <SubchannelScaleParam name="LightMagentaScale"/>
     </subchannel>
    </channel>
   </Channels>
  </InkName>
 </InkList>
</escp2InkGroup>
</gutenprint>
