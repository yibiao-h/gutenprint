<?xml version="1.0"?>

<gutenprint xmlns="http://gimp-print.sourceforge.net/xsd/gp.xsd-1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://gimp-print.sourceforge.net/xsd/gp.xsd-1.0 gutenprint.xsd">
  <copyright>
    * EPSON ET-8550 white/color raw inks.
    * The main app prepares CMYK and white raw interop rasters.
  </copyright>
  <escp2InkGroup name="et8550">
    <InkList translate="text" name="ColorOffset" text="ET-8550 Color Offset Raw Inks">
      <Shades>
        <shade count="1">1.000000</shade><shade count="1">1.000000</shade><shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade><shade count="1">1.000000</shade><shade count="1">1.000000</shade>
      </Shades>
      <InkName translate="text" name="ColorOffset6" text="Offset Color + Base White Raw" InkID="Extended">
        <Channels>
          <channel name="et8550_cyan_offset" index="0"><subchannel color="2" headOffset="189" name="Cyan" text="Cyan" translate="text"><ChannelDensityParam name="CyanDensity" /></subchannel></channel>
          <channel name="et8550_magenta_offset" index="1"><subchannel color="1" headOffset="189" name="Magenta" text="Magenta" translate="text"><ChannelDensityParam name="MagentaDensity" /></subchannel></channel>
          <channel name="et8550_yellow_offset" index="2"><subchannel color="4" headOffset="188" name="Yellow" text="Yellow" translate="text"><ChannelDensityParam name="YellowDensity" /></subchannel></channel>
          <channel name="et8550_black_offset" index="3"><subchannel color="0" headOffset="189" name="Black" text="Black" translate="text"><ChannelDensityParam name="BlackDensity" /></subchannel></channel>
          <channel name="et8550_white_photoblack_base" index="4"><subchannel color="0" subchannel="4" name="PhotoblackWhite" text="Photoblack White" translate="text"><ChannelDensityParam name="GlossDensity" /></subchannel></channel>
          <channel name="et8550_white_gray_base" index="5"><subchannel color="0" subchannel="1" name="GrayWhite" text="Gray White" translate="text"><ChannelDensityParam name="GlossDensity" /></subchannel></channel>
        </Channels>
      </InkName>
    </InkList>

    <InkList translate="text" name="WhiteOffset" text="ET-8550 White Offset Raw Inks">
      <Shades>
        <shade count="1">1.000000</shade><shade count="1">1.000000</shade><shade count="1">1.000000</shade>
        <shade count="1">1.000000</shade><shade count="1">1.000000</shade><shade count="1">1.000000</shade>
      </Shades>
      <InkName translate="text" name="WhiteOffset6" text="Base Color + Offset White Raw" InkID="Extended">
        <Channels>
          <channel name="et8550_cyan_base" index="0"><subchannel color="2" headOffset="1" name="Cyan" text="Cyan" translate="text"><ChannelDensityParam name="CyanDensity" /></subchannel></channel>
          <channel name="et8550_magenta_base" index="1"><subchannel color="1" headOffset="1" name="Magenta" text="Magenta" translate="text"><ChannelDensityParam name="MagentaDensity" /></subchannel></channel>
          <channel name="et8550_yellow_base" index="2"><subchannel color="4" name="Yellow" text="Yellow" translate="text"><ChannelDensityParam name="YellowDensity" /></subchannel></channel>
          <channel name="et8550_black_base" index="3"><subchannel color="0" headOffset="1" name="Black" text="Black" translate="text"><ChannelDensityParam name="BlackDensity" /></subchannel></channel>
          <channel name="et8550_white_photoblack_offset" index="4"><subchannel color="0" subchannel="4" headOffset="188" name="PhotoblackWhite" text="Photoblack White" translate="text"><ChannelDensityParam name="GlossDensity" /></subchannel></channel>
          <channel name="et8550_white_gray_offset" index="5"><subchannel color="0" subchannel="1" headOffset="188" name="GrayWhite" text="Gray White" translate="text"><ChannelDensityParam name="GlossDensity" /></subchannel></channel>
        </Channels>
      </InkName>
    </InkList>
  </escp2InkGroup>
</gutenprint>

